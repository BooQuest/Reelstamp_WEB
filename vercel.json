{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "functions": {
    "app/ai/generate-reel-script/route.ts": {
      "maxDuration": 300
    },
    "app/ai/revise-reel-script/route.ts": {
      "maxDuration": 300
    },
    "app/ai/revise-reel-script-full/route.ts": {
      "maxDuration": 300
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "reelstamp.co.kr" }],
      "destination": "https://app.wadiz.kr/links/iVI7Zgn7Vj",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.reelstamp.co.kr" }],
      "destination": "https://app.wadiz.kr/links/iVI7Zgn7Vj",
      "permanent": false
    }
  ]
}
